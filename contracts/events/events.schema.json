  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "address": {
      "type": "object",
      "required": [
        "line1",
        "city",
        "state_code",
        "pincode"
      ],
      "properties": {
        "line1": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state_code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "pincode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "address_kind": {
