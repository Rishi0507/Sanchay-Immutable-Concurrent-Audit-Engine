{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elev05/contracts/events.schema.json",
  "title": "Business event",
  "type": "object",
  "required": [
    "seq",
    "event_type",
    "entity_id",
    "aggregate_id",
    "aggregate_version",
    "sale_id",
    "payload",
    "business_date",
    "recorded_at",
    "identity",
    "idempotency_key",
    "prev_hash",
    "hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "CustomerCreated",
        "CustomerUpdated",
        "VendorCreated",
        "VendorUpdated",
        "CompanyOfficerRecorded",
        "PriceSet",
        "PromotionCreated",
        "EnquiryRecorded",
        "SalesOrderCreated",
        "DispatchRecorded",
        "EWayBillGenerated",
        "LorryReceiptRecorded",
        "DeliveryRecorded",
        "InvoiceIssued",
        "Gstr1Filed",
        "ReceiptRecorded",
        "BankStatementImported",
        "CreditNoteIssued",
        "SalesReturnRecorded",
        "PurchaseInvoiceRecorded",
        "GoodsReceiptRecorded",
        "PaymentMade",
        "JournalPosted",
        "DocumentReversed",
        "SalesRegisterUploaded",
        "RelatedPartyListUploaded",
        "EvidenceUploaded"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "sale_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "business_date": {
      "$ref": "#/$defs/date"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "idempotency_key": {
      "type": "string"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CustomerCreated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_CustomerCreated"
          }
        }
      }
    },
    {
