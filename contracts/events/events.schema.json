            "string",
            "null"
          ]
        },
        "din": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "user",
        "role"
      ],
      "properties": {
        "user": {
          "type": "string"
        },
        "role": {
          "enum": [
            "client_employee",
            "auditor",
            "audit_manager"
          ]
        }
      },
      "additionalProperties": false
