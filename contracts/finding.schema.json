{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "One audit finding (PRD section 15.1). Stored in audit.findings and returned by the audit engine.",
  "type": "object",
  "required": ["finding_id", "engagement_id", "detector_id", "category", "severity", "title", "subject", "amount_impact", "period_effect", "reason", "status"],
  "properties": {
    "finding_id": {"type": "string", "description": "fnd_ followed by 16 hexadecimal characters of SHA-256 over engagement, category, subtype and subject."},
    "engagement_id": {"type": "string"},
    "detector_id": {"type": "string", "pattern": "^D-[0-9]{2}$"},
    "category": {
      "type": "string",
      "enum": [
        "REGISTER_MISMATCH", "RP_UNDISCLOSED", "RP_MID_PERIOD", "CIRCULAR_TRADING", "NO_MOVEMENT",
        "CUTOFF", "PERIOD_END_CONCENTRATION", "DOC_TAX_MISMATCH", "NON_SALE_REVENUE", "EVIDENCE_SUSPECT",
        "CREDIT_NOTE", "PROMOTION_DISCOUNT", "SETTLEMENT", "DOCUMENT_INTEGRITY", "POST_TESTING_CHANGE",
        "LEDGER_INTEGRITY"
      ]
    },
    "subtype": {"type": ["string", "null"]},
    "severity": {"type": "string", "enum": ["High", "Medium", "Low"]},
    "title": {"type": "string"},
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "enum": ["invoice", "customer", "credit_note", "journal", "cycle", "sample", "register_row", "receipt", "gstr1", "chain", "period"]},
        "id": {"type": "string"},
        "label": {"type": "string", "description": "Human readable reference, for example the invoice number."}
      }
    },
    "amount_impact": {"type": "integer", "description": "Value at risk in paise."},
    "period_effect": {"type": "string", "enum": ["Overstated", "Understated", "None"]},
    "proposed_adjustment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "debit", "credit"],
        "properties": {
          "account": {"type": "string"},
          "debit": {"type": "integer"},
          "credit": {"type": "integer"},
          "narration": {"type": "string"}
        }
      }
    },
    "standard_refs": {"type": "array", "items": {"type": "string"}},
    "lineage": {
      "type": "object",
      "properties": {
        "event_seqs": {"type": "array", "items": {"type": "integer"}},
        "document_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_hashes": {"type": "array", "items": {"type": "string"}},
        "register_rows": {"type": "array", "items": {"type": "integer"}},
        "rule_id": {"type": "string"},
        "thresholds": {"type": "object"},
        "values": {"type": "object", "description": "The compared values that triggered the rule."}
      }
    },
    "reason": {"type": "string", "description": "Plain-language explanation built from a template and the lineage."},
    "sample_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["proposed", "confirmed", "rejected", "needs_info"]},
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]},
    "decision_note": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
