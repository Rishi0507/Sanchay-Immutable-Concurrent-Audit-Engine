# Copy to .env and change every value before any shared deployment.

POSTGRES_PASSWORD=postgres

# Shared by the internal services (X-Service-Token).
SERVICE_TOKEN=dev-service-token

# One bearer token per demo identity.
TOKEN_CLIENT=client-demo-token
TOKEN_AUDITOR=auditor-demo-token
TOKEN_MANAGER=manager-demo-token

# Legal entity used when a tool call names none.
DEFAULT_ENTITY=E1

# Ports published on the host.
MCP_PORT=8080
UI_PORT=5173
