# Copy to .env and change every value before any shared deployment.

POSTGRES_PASSWORD=postgres

# Shared by the internal services (X-Service-Token).
SERVICE_TOKEN=dev-service-token

# One bearer token per demo identity.
TOKEN_CLIENT=client-demo-token
TOKEN_AUDITOR=auditor-demo-token
TOKEN_MANAGER=manager-demo-token

# Legal entity used when a tool call names none.
DEFAULT_ENTITY=E1

# Ports published on the host.
MCP_PORT=8080
UI_PORT=5173

# Optional hosted model. Never commit a real key.
# LLM_URL ending in /v1 gets /chat/completions appended. Any other address is used as given.
LLM_URL=
LLM_API_KEY=

# Model for the auditor agent (agent/audit_agent.py).
AGENT_MODEL=

# Model for the engine: evidence extraction and memo wording. Leave empty to run the engine
# with pattern rules and template text only, so no step in the application spends tokens.
LLM_MODEL=

# Model that words the audit assistant's answers. Leave empty and the assistant answers
# straight from the records and spends no tokens.
CHAT_MODEL=
# Tokens the assistant may use in a day. Beyond it, answers come from the records.
CHAT_DAILY_TOKENS=100000

# Document reading needs little reasoning, and hidden reasoning is billed as output.
LLM_REASONING_EFFORT=minimal
# Concurrent requests to the model. Keep it low to avoid bursts.
LLM_WORKERS=2

# One bearer token per client department (sales, dispatch, accounts, admin).
TOKEN_SALES=sales-demo-token
TOKEN_DISPATCH=dispatch-demo-token
TOKEN_ACCOUNTS=accounts-demo-token
TOKEN_ADMIN=admin-demo-token

# Report emails through Twilio SendGrid (send_report_email). Never commit a real key.
# Leave SENDGRID_API_KEY empty to preview emails in the app without sending anything.
SENDGRID_API_KEY=
# A sender address or domain verified in SendGrid (Settings > Sender Authentication).
EMAIL_FROM=
EMAIL_FROM_NAME=Revenue Audit
# Who receives each report. Comma-separated addresses.
# findings_review goes to the audit manager, and to the partner when one is named.
EMAIL_TO_MANAGER=
EMAIL_TO_PARTNER=
EMAIL_TO_AUDITOR=
# evidence_reminder goes to the client's staff who upload documents.
EMAIL_TO_CLIENT=
# findings_memo goes to the client's management, only after sign-off.
EMAIL_TO_CLIENT_MANAGEMENT=
